{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://intervention-consistent-feelings-benchmark.trycloudflare.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://intervention-consistent-feelings-benchmark.trycloudflare.com/health"
    },
    {
      "source": "/((?!api|health|ws).*)",
      "destination": "/index.html"
    }
  ]
}
